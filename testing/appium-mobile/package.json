{
  "name": "lifora-appium-mobile-framework",
  "version": "1.0.0",
  "description": "Enterprise Appium 2.x Android Mobile E2E Test Automation Framework for React Native/Android APK",
  "main": "index.js",
  "scripts": {
    "test": "mocha --config .mocharc.json",
    "test:auth": "mocha --config .mocharc.json tests/auth.test.js",
    "test:forms": "mocha --config .mocharc.json tests/formValidation.test.js",
    "test:gestures": "mocha --config .mocharc.json tests/gestures.test.js",
    "test:ai": "mocha --config .mocharc.json tests/aiSmartTest.test.js",
    "report:excel": "node -e \"require('./utilities/ExcelReportGenerator').generateFinalReport()\""
  },
  "keywords": [
    "appium2",
    "android",
    "react-native",
    "e2e",
    "automation",
    "mocha",
    "chai",
    "exceljs",
    "winston"
  ],
  "author": "LIFORA QA Automation Architect",
  "license": "ISC",
  "dependencies": {
    "appium": "^2.5.1",
    "appium-uiautomator2-driver": "^3.0.0",
    "chai": "^4.3.10",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "mocha": "^10.3.0",
    "mochawesome": "^7.1.3",
    "mochawesome-merge": "^4.3.0",
    "mochawesome-report-generator": "^6.2.0",
    "webdriverio": "^8.32.0",
    "winston": "^3.11.0"
  }
}
